---
interface Video {
  src: string;
  label: string;
}

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  videos: Video[];
  orientation: 'horizontal' | 'vertical';
}

const { id, title, subtitle, videos, orientation } = Astro.props;
const cardClass = orientation === 'horizontal' ? 'video-card-h' : 'video-card-v';
---

<section id={id} style="padding: 5rem 0;">
  <div class="fw-container">
    <div style="text-align: center; margin-bottom: 4rem;" class="fade-in">
      <h2 class="section-title" style="margin-bottom: 1.5rem;">{title}</h2>
      {subtitle && <p style="font-size: 0.95rem; color: #8a7968; letter-spacing: 0.05em; max-width: 700px; margin: 0 auto;">{subtitle}</p>}
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;" class="fade-in">
      <button class="carousel-nav" onclick={`scrollCarousel('${id}-track', -1)`} aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div id={`${id}-track`} class="carousel-track" style="flex: 1;">
        {videos.map((video) => (
          <div class={`${cardClass} video-card-interactive`}>
            <video muted loop playsinline controls preload="none">
              <source data-src={video.src} type="video/mp4" />
            </video>
            <div class="video-card-label">
              <p style="font-size: 0.875rem; letter-spacing: 0.15em; text-transform: uppercase; color: #8a7968;">{video.label}</p>
            </div>
          </div>
        ))}
      </div>

      <button class="carousel-nav" onclick={`scrollCarousel('${id}-track', 1)`} aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>
